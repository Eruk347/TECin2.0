@page "/departments/details/{Id:int}"
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@using TECin2.Blazor.Models
@using TECin2.Blazor.Services
@using TECin2.Blazor.Models.DTOs
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<h3>Detaljer for afdeling: @Department.Name</h3>

<div class="row">
    @if (IsLoading)
    {
        <p>Indlæser data...</p>
    }
    else
    {
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Afdelingsnavn</label>
                <span class="form-control">@Department.Name</span>
            </div>
            <div class="form-group">
                <label class="control-label">Afdelingsleder</label>
                <span class="form-control">@DepartmentHead.FirstName @DepartmentHead.LastName</span>
            </div>
            <div class="form-group">
                @foreach (Group _group in Department.Groups!)
                {
                        @_group.Name
                }
            </div>
            <p></p>
            <button class="btn btn-warning" @onclick="GoToEdit">Rediger</button>
            <button class="btn btn-secondary" @onclick="GoToIndex">Tilbage til listen</button>
        </div>
    }
</div>
@code {
    private readonly IDepartmentService _departmentService;
    private readonly IInstructorService _instructorService;
    private LogInResponse? CurrentUserData { get; set; }
    private bool IsLoading = true;
    private bool ShouldRedirectToLogin = false;

    [Parameter]
    public required int Id { get; set; }
    private Department Department { get; set; } = new Department { Name = "" };
    private Instructor DepartmentHead { get; set; } = new Instructor { Id = "", FirstName = "", LastName = "", UserName = "", Role = new Role { Name = "", Description = "" }, Groups = [], };

    public DepartmentsDetails(IDepartmentService departmentService, IInstructorService instructorService)
    {
        _departmentService = departmentService;
        _instructorService = instructorService;
    }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var department = await _departmentService.GetDepartmentById(Id);
            if (department == null)
            {
                NavigationManager.NavigateTo("/departments/index", true);
                return;
            }
            Department = department;

            var departmentHead = await _instructorService.GetInstructorById(department.DepartmentHead!);
            if (departmentHead == null)
            {
                NavigationManager.NavigateTo("/departments/index", true);
                return;
            }
            DepartmentHead = departmentHead;
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoToIndex()
    {
        NavigationManager.NavigateTo("/departments/index", true);
    }

    private void GoToEdit()
    {
        NavigationManager.NavigateTo("/departments/edit/" + Id, true);
    }
}
