@page "/departments/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@using TECin2.ClassLibrary
@using TECin2.Blazor.Services
@using TECin2.ClassLibrary.DTOs; @using TECin2.ClassLibrary.Entities
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IDepartmentService _departmentService
@inject IInstructorService _instructorService

<h3>Rediger afdelinge: @Department.Name</h3>

<div class="row">
    @if (IsLoading)
    {
        <p>Indlæser data...</p>
    }
    else
    {
        <div class="col-md-4">
            <EditForm Model="@Department" method="post" OnValidSubmit="OnPostAsync" Id="instructorForm" FormName="Create">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label @bind="Department.Name" class="control-label">Navn</label>
                    <label>*</label>
                    <InputText @bind-value="Department.Name" class="form-control" />
                    <span asp-validation-for="Department.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Afdelingsleder</label>
                    <InputSelect id="departmentHead" class="form-select" @bind-Value="Department.DepartmentHead">
                        @foreach (var _instructor in Instructors)
                        {
                            <option value="@_instructor.Value">@_instructor.Text</option>
                        }
                    </InputSelect>
                    <span asp-validation-for="instructor.RoleId" class="text-danger"></span>
                </div>
                <p></p>
                <input type="submit" value="Udfør" class="btn btn-primary" />
                <button class="btn btn-secondary" @onclick="GoToIndex">Tilbage til listen</button>
            </EditForm>
            
        </div>
    }
</div>
@code {
    private bool IsLoading = true;
    private bool ShouldRedirectToLogin = false;

    [Parameter]
    public required int Id { get; set; }

    [SupplyParameterFromForm]
    private DepartmentRequest Department { get; set; } = new DepartmentRequest { Name = "" };

    private LogInResponse? CurrentUserData { get; set; }
    private List<SelectListItem> Instructors { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var _department = await _departmentService.GetDepartmentById(Id);

            if (_department == null)
            {
                NavigationManager.NavigateTo("/departments/index", true);
                return;
            }

            Department = new DepartmentRequest
            {
                Name = _department.Name,
                Deactivated = _department.Deactivated,
                DepartmentHead = _department.DepartmentHead,
                SchoolId = _department.SchoolId
            };

            List<Instructor> instructors = await _instructorService.GetAllInstructors();
            foreach (var _instructor in instructors)
            {
                if (_instructor != null)
                {
                    Instructors.Add(new SelectListItem
                    {
                        Value = _instructor.Id.ToString(),
                        Text = $"{_instructor.FirstName} {_instructor.LastName}"
                    });
                }
            }
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    public async Task<IActionResult?> OnPostAsync()
    {
        //school selection
        Department.Deactivated = false;
        Department.SchoolId = 1;
        var result = await _departmentService.UpdateDepartment(Department, Id);
        if (result != null)
        {
            NavigationManager.NavigateTo("/departments/index", true);
            return new OkResult();
        }
        return null;
    }

    private void GoToIndex()
    {
        NavigationManager.NavigateTo("/departments/index", true);
    }
}
