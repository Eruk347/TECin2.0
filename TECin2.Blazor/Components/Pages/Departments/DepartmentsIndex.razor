@page "/departments/index"
@using TECin2.ClassLibrary.DTOs;
@using TECin2.ClassLibrary.Entities
@using TECin2.Blazor.Services
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IDepartmentService _departmentService

<h3>Afdelinger</h3>

@if (IsLoading)
{
    <p>Henter data</p>
}
else
{
    <a href="/departments/create">Ny afdeling</a>
    <a href="/groups/create">Ny gruppe</a>
    <br />
    @foreach (var _department in Departments!)
    {
        <h3>
            <a href="/departments/details/@_department.Id">@_department.Name</a>
        </h3>
        <table class="table">
            <thead>
                <tr>
                    <th width="20%" />
                    <th width="12%">
                        Mødetid
                    </th>
                    <th width="12%">
                        Fremmødt
                    </th>
                    <th width="12%">
                        Forsinket
                    </th>
                    <th width="12%">
                        Fraværende
                    </th>
                    <th width="12%">
                        I alt
                    </th>
                    <th width="30%" >
                        <a href="/departments/details/@_department.Id">Detaljer</a>
                        |
                        <a href="/departments/edit/@_department.Id">Rediger</a>
                        |
                        <a href="/departments/delete/@_department.Id"> Slet </a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (Group _group in _department.Groups!)
                {
                    <DepartmentsIndexDetails Group="_group" CurrentUserData="CurrentUserData" />
                    @* <tr>
                        <td>
                            <a href="/groups/details/@_group.Id">@_group.Name</a>
                        </td>
                        <td>
                            @_group.ArrivalTime
                        </td>
                        <td />
                        <td />
                        <td />
                        <td />
                        <td>
                            <a href="/groups/details/@_group.Id">Detaljer</a>
                            |
                            <a href="/groups/edit/@_group.Id">Rediger</a> 
                            |
                            <a href="/groups/delete/@_group.Id">Slet</a>
                        </td>
                    </tr> *@
                }
            </tbody>
        </table>
        <br />
    }
}



@code {
    private LogInResponse? CurrentUserData { get; set; }
    List<Department>? Departments = [];
    private bool IsLoading = true;
    private bool ShouldRedirectToLogin = false;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }
    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            Departments = await _departmentService.GetAllDepartments();

            if (Departments == null)
            {
                //hvis noget med en fejl at der ikke er nogen list - empty list betyder der er kommet et svar, null, betyder noget er galt
                Departments = new List<Department>();
            }

            Departments = Departments.OrderBy(x => x.Name).ToList();

            if (CurrentUserData!.RoleRank > 2)
            {
                int ownDepartment = CurrentUserData!.Groups[0].DepartmentId;

                Departments.RemoveAll(department => department.Id != ownDepartment);
            }

        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;

        }
    }
}