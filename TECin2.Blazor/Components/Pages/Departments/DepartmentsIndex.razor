@code {
    private readonly IDepartmentService _departmentService;
    //static DepartmentService _departmentService = new();
    List<Department>? departments = [];

    public DepartmentsIndex(IDepartmentService departmentService)
    {
        _departmentService = departmentService;
    }

    protected override async Task OnInitializedAsync()
    {
        //check token validation


        departments = await _departmentService.GetAllDepartments();

        if (departments == null)
        {
            //hvis noget med en fejl at der ikke er nogen list - empty list betyder der er kommet et svar, null, betyder noget er galt
            departments = new List<Department>();
        }

        departments = departments.OrderBy(x => x.Name).ToList();
    }




}
