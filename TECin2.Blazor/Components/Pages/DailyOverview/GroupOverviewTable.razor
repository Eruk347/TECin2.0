@inject NavigationManager NavigationManager
@using TECin2.Blazor.Models.DTOs
@using TECin2.Blazor.Services
<div class="row">
    <div class="col">
        <h3>@GroupResponse.Name</h3>
        <h4>Mødetid: @GroupResponse.ArrivalTime</h4>
    </div>
    <div class="col">
        <div class="row">
            <div class="col">
                <h4>Mødt i dag: </h4>
            </div>
            <div class="col">
                <h4>@arrivedStudents</h4>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <h4>Ud af: </h4>
            </div>
            <div class="col">
                <h4>@CheckIns.Count</h4>
            </div>
        </div>
    </div>
</div>
<table class="bg-transparent table2 table-hover ">
    <thead>
        <tr>
            <th>Fornavn</th>
            <th>Efternavn</th>
            <th>Tlf</th>
            <th>Email</th>
            <th>Ankomst</th>
            <th>Afgang</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in CheckIns)
        {
            <tr style="background:@TableColor.Color(item, CurrentUserData, Date)">
                <td>
                    <button class="btn "
                            @onclick="() => GoToStudent(item.UserId)"
                            style="--bs-btn-padding-y: .1rem; --bs-btn-padding-x: .1rem; ">
                        @item.FirstName
                    </button>
                </td>
                <td>@item.LastName</td>
                <td>@item.Phonenumber</td>
                <td>@item.Email</td>
                <td>@item.Arrival</td>
                <td>@item.Departure</td>
            </tr>
        }
    </tbody>
</table>
@code {
    [Parameter]
    public List<CheckInResponseLong> CheckIns { get; set; } = [];

    [Parameter]
    public LogInResponse CurrentUserData { get; set; } = null!;

    [Parameter]
    public DateOnly Date { get; set; }

    public required LogInGroupResponse GroupResponse { get; set; }

    public int arrivedStudents { get; set; }



    protected override void OnInitialized()
    {
        //tag id fra checkin[0] og fra listen af grupper i login, for at finde gruppenavn
        foreach (var group in CurrentUserData.Groups)
        {
            if (group.Id == CheckIns[0].GroupId)
            {
                GroupResponse = group;
            }
        }
        foreach (var checkIn in CheckIns)
        {
            if (checkIn.Arrival != new TimeOnly())
                arrivedStudents++;
        }

    }

    private void GoToStudent(string _id)
    {
        NavigationManager.NavigateTo("/students/details/" + _id, true);
    }
}
