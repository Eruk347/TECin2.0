@code {
    private readonly IDailyOverviewService _dailyOverviewService;

    List<List<CheckInResponseLong>> listOfCheckIns = [];


    public DailyOverview(IDailyOverviewService dailyOverviewService)
    {
        _dailyOverviewService = dailyOverviewService;
    }

    protected override async Task OnInitializedAsync()
    {
        //NavigationManager.NavigateTo("/login", false);


        //control af token
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {


            LogInResponse? _currentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

            if (_currentUserData == null)
            {
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            foreach (var group in _currentUserData.Groups)
            {
                var checkIns = await _dailyOverviewService.GetCheckInsForToday(group.Id, DateOnly.FromDateTime(DateTime.Now));
                if (checkIns != null)
                {
                    listOfCheckIns.Add(checkIns);
                }
            }


        }

    }
}
