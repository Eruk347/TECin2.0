@page "/dailyoverview"
@rendermode InteractiveServer
@using System.Drawing
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc
@using TECin2.Blazor.Models
@using TECin2.Blazor.Models.DTOs
@using TECin2.Blazor.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject IDailyOverviewService dailyOverviewService

<div class="container">

    <h3>Dagens oversigt</h3>

    <EditForm Model=@listOfCheckIns>
        <input type="date" id="datePicker" @onchange="OnDateChanged" value="@SelectedDate" runat="server" />
        @if (IsLoading)
        {
            <p>Indlæser data</p>
        }
        @if (listOfCheckIns != null)
        {
            <div class="col">
                <h3>Mødetid </h3>
            </div>
            @foreach (var list in listOfCheckIns)
            {
                <GroupOverviewTable CheckIns="list" httpContext="HttpContextAccessor.HttpContext" />
            }
        }
    </EditForm>
</div>
