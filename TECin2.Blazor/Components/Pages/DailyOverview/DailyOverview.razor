@code {

    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Now);
    private bool IsLoading = true;

    List<List<CheckInResponseLong>> listOfCheckIns = [];



    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync(SelectedDate);
    }

    private async Task LoadDataAsync(DateOnly _selectedDate)
    {
        IsLoading = true;

        listOfCheckIns.Clear();

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext != null)
            {
                LogInResponse? _currentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

                if (_currentUserData == null)
                {
                    NavigationManager.NavigateTo("/login", true);
                    return;
                }

                foreach (var group in _currentUserData.Groups)
                {
                    var checkIns = await dailyOverviewService.GetCheckInsForToday(group.Id, SelectedDate);
                    if (checkIns != null)
                    {
                        listOfCheckIns.Add(checkIns);
                    }
                }
            }
        }
        catch (Exception)
        {

            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        SelectedDate = DateOnly.Parse(e.Value.ToString() ?? string.Empty);
        if (SelectedDate != null)
        {
            await LoadDataAsync(SelectedDate);
        }
    }



    public string Color(CheckInResponseLong checkInResponse)//husk SeeAll setting
    {
        string red = "#FF0000";
        string yellow = "#CDA01E";

        if (checkInResponse.Arrival == new TimeOnly())
        {
            return red;
        }

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            LogInGroupResponse? group = null;
            LogInResponse? _currentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");
            if (_currentUserData == null)
            {
                NavigationManager.NavigateTo("/login", true);
                return red;
            }

            foreach (var item in _currentUserData.Groups)
            {
                if (item.Id == checkInResponse.GroupId)
                {
                    group = item;
                    break;
                }
            }

            if (group == null)
            {
                return red;
            }

            //group flex
            if (group.FlexibleArrivalEnabled)
            {
                if (checkInResponse.Arrival > group.ArrivalTime.Add(group.FlexibleAmount ?? new()))
                {
                    return yellow;
                }
            }

            //group arrivaltime
            if (checkInResponse.Arrival > group.ArrivalTime)
            {
                return yellow;
            }

            //group departure
            if (checkInResponse.Departure != new TimeOnly())
            {
                if (group.FlexibleArrivalEnabled)
                {
                    group.ArrivalTime = group.ArrivalTime.Add(group.FlexibleAmount ?? new());
                }

                TimeSpan time;

                switch ((int)DateTime.Now.DayOfWeek)
                {
                    case 1:
                        time = group.WorkHoursInDay.Monday;
                        break;
                    case 2:
                        time = group.WorkHoursInDay.Tuesday;
                        break;
                    case 3:
                        time = group.WorkHoursInDay.Wednesday;
                        break;
                    case 4:
                        time = group.WorkHoursInDay.Thursday;
                        break;
                    case 5:
                        time = group.WorkHoursInDay.Friday;
                        break;
                    default:
                        return red;
                }
                TimeSpan? timeWorked = checkInResponse.Departure - checkInResponse.Arrival;

                if (timeWorked != null)
                {
                    if (timeWorked < time)
                    {
                        return red;
                    }
                }

            }

            return "#FFFFFF";
        }
        return red;
    }
}
