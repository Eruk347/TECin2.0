@page "/dailyoverview"
@rendermode InteractiveServer
@using System.Drawing
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Mvc
@using TECin2.Blazor.Models
@using TECin2.Blazor.Models.DTOs
@using TECin2.Blazor.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject IDailyOverviewService dailyOverviewService

<div>
    <div class="row">
        <dir class="col">
            <h2>Dagens oversigt</h2>
        </dir>
        <dir class="col" con>
            <EditForm Model=@listOfCheckIns>
                <input type="date" id="datePicker" @bind="SelectedDate" @bind:format="yyyy-MM-dd" />
            </EditForm>
        </dir>
    </div>
    <hr size="5" />
    <div>
        @if (IsLoading)
        {
            <p>Indlæser data</p>
        }
        else
        {
            @if (listOfCheckIns != null)
            {
                @foreach (var list in listOfCheckIns)
                {
                    <GroupOverviewTable CheckIns="list" CurrentUserData="CurrentUserData" Date="SelectedDate" />
                    <hr size="5" />
                }
            }
        }
    </div>
</div>

@code {
    private bool IsLoading = true;
    private LogInResponse? CurrentUserData { get; set; }
    List<List<CheckInResponseLong>> listOfCheckIns = [];

    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly SelectedDate
    {
        get => selectedDate;
        set
        {
            if (selectedDate != value)
            {
                selectedDate = value;
                _ = LoadDataAsync(selectedDate); // Fire and forget, or make this async if you want to await
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        await LoadDataAsync(SelectedDate);
    }

    private async Task LoadDataAsync(DateOnly _selectedDate)
    {
        IsLoading = true;

        listOfCheckIns.Clear();

        if (CurrentUserData == null)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        try
        {
            foreach (var group in CurrentUserData.Groups)
            {
                var checkIns = await dailyOverviewService.GetCheckInsForToday(group.Id, SelectedDate);
                if (checkIns != null)
                {
                    listOfCheckIns.Add(checkIns);
                }
            }
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e.Value != null)
            SelectedDate = DateOnly.Parse(e.Value.ToString() ?? string.Empty);
        else
            SelectedDate = DateOnly.FromDateTime(DateTime.Now);
        await LoadDataAsync(SelectedDate);
    }
}
