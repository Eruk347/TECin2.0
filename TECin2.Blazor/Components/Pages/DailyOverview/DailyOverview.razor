@page "/dailyoverview"
@using TECin2.Blazor.Models
@using TECin2.Blazor.Models.DTOs
@using TECin2.Blazor.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager


<h3>Dagens oversigt</h3>
<div>
    <div class="col">
        <h3>Mødetid: </h3>
    </div>
    @if (listOfCheckIns != null)
    {
        @foreach (var list in listOfCheckIns)
        {
            <table>
                <tr>
                    <th>Fornavn</th>
                    <th>Efternavn</th>
                    <th>Tlf</th>
                    <th>Ankomst</th>
                    <th>Afgang</th>
                    <th>I alt</th>
                    <th>Fremmødt</th>
                </tr>
                @foreach (var item in list)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Phonenumber</td>
                        <td>@item.Email</td>
                        <td>@item.Arrival</td>
                        <td>@item.Departure</td>
                    </tr>
                }
            </table>
        }
    }
</div>
