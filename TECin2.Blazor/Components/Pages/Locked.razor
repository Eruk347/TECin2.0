@page "/locked/{input}"
@rendermode InteractiveServer
@using System.Globalization
@using TECin2.ClassLibrary.DTOs; @using TECin2.ClassLibrary.Entities
@using TECin2.Blazor.Services
@using TECin2.Blazor.Components.Pages.Departments
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<div style="height:90px">
    <h3>test</h3>
    <div>
        @if (IsLoading)
        {
            <p>Indlæser data...</p>
        }
        else
        {
            if (input == "students")
            {
                <div>
                    <TECin2.Blazor.Components.Pages.Students.StudentsIndex />
                </div>
            }
            else
            {
                <div>
                    <DepartmentsIndex />
                </div>
            }
        }
    </div>
</div>

@code {
    private bool IsLoading = true;
    private bool ShouldRedirectToLogin = false;
    private LogInResponse? CurrentUserData { get; set; }

    [Parameter]
    public required string input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;

        try
        {
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
