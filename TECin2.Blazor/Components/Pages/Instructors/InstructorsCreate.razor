@page "/instructors/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@using TECin2.ClassLibrary
@using TECin2.Blazor.Services
@using TECin2.ClassLibrary.DTOs
@using TECin2.ClassLibrary.Entities
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<h3>Opret Instruktør</h3>
@if (IsLoading)
{
    <p>Indlæser data...</p>
}
else
{
    <div>
        <EditForm Model="@Instructor" method="post" OnValidSubmit="OnPostAsync" Id="instructorForm" FormName="Create">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label @bind="Instructor.FirstName" class="control-label">Fornavn</label>
                        <label>*</label>
                        <InputText @bind-value="Instructor.FirstName" class="form-control" />
                        <span asp-validation-for="Instructor.FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label @bind="instructor.LastName" class="control-label">Efternavn</label>
                        <label>*</label>
                        <InputText @bind-value="Instructor.LastName" class="form-control" />
                        <span asp-validation-for="Instructor.LastName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label @bind="Instructor.Username" class="control-label">Brugernavn</label>
                        <label>*</label>
                        <InputText @bind-value="Instructor.UserName" class="form-control" />
                        <span asp-validation-for="Instructor.UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Instructor.Email" class="control-label">Email</label>
                        <InputText @bind-value="Instructor.Email" class="form-control" />
                        <span asp-validation-for="Instructor.Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Instructor.Phonenumber" class="control-label">Telefonnummer</label>
                        <InputNumber @bind-value="Instructor.Phonenumber" class="form-control" />
                        <span asp-validation-for="Instructor.Phonenumber" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label">Password</label>
                        <label>*</label>
                        <InputText @bind-value="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label">Gentag password</label>
                        <label>*</label>
                        <InputText @bind-value="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Rolle*</label>
                        <InputSelect id="role" class="form-select" @bind-Value="Instructor.RoleId">
                            @foreach (var role in RolesForCombobox)
                            {
                                <option value="@role.Value">@role.Text</option>
                            }
                        </InputSelect>
                        <span asp-validation-for="instructor.RoleId" class="text-danger"></span>
                    </div>
                </div>
                <br />
                <div class="col-md-4">
                    <h3>
                        Tilmeld grupper:
                    </h3>
                    <div class="form-group">
                        <InputRadioGroup @bind-Value="PrimaryGroup" class="form-check-input">
                            @foreach (var department in Departments)
                            {
                                <h5> Afdeling: @department.Name</h5>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Tilmeld</th>
                                            <th>Gruppenavn</th>
                                            <th>Primær gruppe</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @if (department.Groups != null)
                                        {
                                            @foreach (var group in department.Groups)
                                            {
                                                if (group != null)
                                                {
                                                    <tr>
                                                        <td><InputCheckbox @bind-Value=group.Deactivated /></td>
                                                        <td>@group.Name</td>
                                                        <td><InputRadio Value="@group.Id" /></td>
                                                    </tr>
                                                }
                                            }
                                        }

                                    </tbody>
                                </table>
                            }
                        </InputRadioGroup>
                    </div>
                </div>
            </div>
            <p></p>
            <input type="submit" value="Opret" class="btn btn-primary" />
            <button class="btn btn-secondary" @onclick="GoToIndex">Annuler</button>
        </EditForm>
    </div>
}

@code {
    private readonly IInstructorService _instructorService;
    private readonly IRoleService _roleService;
    private readonly IDepartmentService _departmentService;

    [SupplyParameterFromForm]
    private InstructorRequest Instructor { get; set; } = new InstructorRequest { FirstName = "", LastName = "", UserName = "" };
    [SupplyParameterFromForm]
    private string Password { get; set; } = "";
    [SupplyParameterFromForm]
    private string ConfirmPassword { get; set; } = "";
    [SupplyParameterFromForm]
    private int PrimaryGroup { get; set; } = 0;

    private List<SelectListItem> RolesForCombobox = new List<SelectListItem>();
    private List<Department> Departments = new List<Department>();
    private LogInResponse? CurrentUserData { get; set; }
    private bool ShouldRedirectToLogin = false;
    private bool IsLoading = true;

    public InstructorsCreate(IInstructorService instructorService, IRoleService roleService, IDepartmentService departmentService)
    {
        _instructorService = instructorService;
        _roleService = roleService;
        _departmentService = departmentService;
    }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;

        try
        {

            List<Role?> roles = await _roleService.GetAllRoles();
            List<Department> _departments = await _departmentService.GetAllDepartments() ?? new();

            foreach (var role in roles)
            {
                if (role != null && role.Rank >= CurrentUserData!.RoleRank)
                    // if (role.Rank >= CurrentUserData.RoleRank)
                    RolesForCombobox.Add(new SelectListItem { Text = role.Name, Value = role.Id.ToString() });
            }

            if (CurrentUserData!.RoleRank < 2)
            {
                Departments = _departments;
            }
            else if (CurrentUserData.RoleRank == 2)
            {
                foreach (var department in _departments)
                {
                    if (department.DepartmentHead == CurrentUserData.Id)
                    {
                        Departments.Add(department);
                    }
                }
            }
            else
            {
                foreach (var _group in CurrentUserData.Groups)
                {
                    foreach (var _department in _departments)
                    {
                        if (_department.Groups != null)
                        {
                            foreach (var group in _department.Groups)
                            {
                                if (group != null && group.Id == _group.Id)
                                {
                                    if (!Departments.Contains(_department))
                                    {
                                        Departments.Add(_department);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    public async Task<IActionResult?> OnPostAsync()
    {
        Instructor.Groups = new();
        foreach (var department in Departments)
        {
            if (department.Groups == null)
            {
                break;
            }
            foreach (var group in department.Groups)
            {
                if (group == null)
                {
                    break;
                }
                if (group.Deactivated)
                {
                    Instructor.Groups.Add(group.Id);
                }
                Instructor.PrimaryGroupId = PrimaryGroup;

            }
        }
        if (Password == ConfirmPassword)
            Instructor.Password = Password;

        Instructor.IsStudent = false;
        Instructor.Deactivated = false;

        var result = await _instructorService.CreateInstructor(Instructor);
        if (result != null)
        {
            NavigationManager.NavigateTo("/instructors/index", true);
        }
        return null;
    }
    private void GoToIndex()
    {
        NavigationManager.NavigateTo("/instructors/index", true);
    }
}
