@page "/instructors/index"
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@using TECin2.Blazor.Models
@using TECin2.Blazor.Models.DTOs
@using TECin2.Blazor.Services

<h3>InstructorsIndex</h3>
<NavLink class="nav-link text-dark" href="/instructors/create">
    <span class="bi" aria-hidden="true"></span> Opret
</NavLink>

<table class="table">
    <thead>
        <tr>
            <th width="200">
                Fornavn
            </th>
            <th width="200">
                Efternavn
            </th>
            <th width="200">
                Telefonnummer
            </th>
            <th width="150">
                Email
            </th>
            <th width="150">
                Brugernavn
            </th>
            <th width="200">
                Gruppe(r)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var instructor in Instructors)
        {
            <tr>
                <td>
                    <a href="/instructors/details/@instructor.Id">@instructor.FirstName</a>
                </td>
                <td>
                    @instructor.LastName
                </td>
                <td>
                    @instructor.Phonenumber
                </td>
                <td>
                    @instructor.Email
                </td>
                <td>
                    @instructor.UserName
                </td>
                <td>
                    @foreach (var group in instructor.Groups)
                        @group.Name
                </td>
                <td>
                    <a href="/instructors/edit/@instructor.Id">Rediger</a> |
                    <a href="/instructors/delete/@instructor.Id">Slet</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br />

@code {
    private readonly IInstructorService _instructorService;
    private readonly IDepartmentService _departmentService;
    private LogInResponse? CurrentUserData { get; set; }
    private bool ShouldRedirectToLogin = false;
    private bool IsLoading = true;

    public InstructorsIndex(IInstructorService instructorService, IDepartmentService departmentService)
    {
        _instructorService = instructorService;
        _departmentService = departmentService;
    }

    public List<Instructor> Instructors { get; set; } = new();
    public List<Department> Departments { get; set; } = new();

    public void NavigateToEdit(string id)
    {
        NavigationManager.NavigateTo($"/instructors/edit/{id}");
    }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        Instructors = await _instructorService.GetAllInstructors();
    }
}
