@page "/instructors/index"
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IDepartmentService _departmentService
@inject IInstructorService _instructorService
@using TECin2.ClassLibrary
@using TECin2.ClassLibrary.DTOs; @using TECin2.ClassLibrary.Entities
@using TECin2.Blazor.Services

<h3>InstructorsIndex</h3>

@if(IsLoading)
{
    <p>Indlæser data...</p>
}
else
{
<NavLink class="nav-link text-dark" href="/instructors/create">
    <span class="bi" aria-hidden="true"></span> Opret
</NavLink>

<table class="table">
    <thead>
        <tr>
            <th width="200">
                Fornavn
            </th>
            <th width="200">
                Efternavn
            </th>
            <th width="200">
                Telefonnummer
            </th>
            <th width="150">
                Email
            </th>
            <th width="150">
                Brugernavn
            </th>
            <th width="200">
                Gruppe(r)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var instructor in Instructors)
        {
            <tr>
                <td>
                    <a href="/instructors/details/@instructor.Id">@instructor.FirstName</a>
                </td>
                <td>
                    @instructor.LastName
                </td>
                <td>
                    @instructor.Phonenumber
                </td>
                <td>
                    @instructor.Email
                </td>
                <td>
                    @instructor.UserName
                </td>
                <td>
                    @foreach (var group in instructor.Groups)
                        @group.Name
                </td>
                <td>
                    <a href="/instructors/edit/@instructor.Id">Rediger</a> |
                    <a href="/instructors/delete/@instructor.Id">Slet</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<br />
}

@code {
    private LogInResponse? CurrentUserData { get; set; }
    private bool ShouldRedirectToLogin = false;
    private bool IsLoading = true;

    public List<Instructor> Instructors { get; set; } = new();
    public List<Department> Departments { get; set; } = new();

    public void NavigateToEdit(string id)
    {
        NavigationManager.NavigateTo($"/instructors/edit/{id}");
    }

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            Instructors = await _instructorService.GetAllInstructors();
            Departments = await _departmentService.GetAllDepartments();
            //fordel grupper på afdelinger
            //fordel instruktører i forhold til deres ene gruppe eller primary group






        }
        catch(Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }


}
