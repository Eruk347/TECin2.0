@page "/settings/index"
@rendermode InteractiveServer
@using System.Globalization
@using TECin2.ClassLibrary
@using TECin2.ClassLibrary.DTOs
@using TECin2.Blazor.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
<h3>SettingsIndex</h3>
<div>
    @if (IsLoading)
    {
        <p>Indlæser data...</p>
    }
    else
    {
        <p>Hello World</p>
    }
</div>
@code {
    private bool IsLoading = true;
    private LogInResponse? CurrentUserData { get; set; }
    private List<Group> Groups { get; set; } = [];
    private bool ShouldRedirectToLogin = false;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;

        try
        {
        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
