@page "/settings/personal"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@inject NavigationManager NavigationManager
@using TECin2.Blazor.Models
@using TECin2.Blazor.Services
@using TECin2.Blazor.Models.DTOs
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IInstructorService _instructorService
@inject ISettingService _settingService

<h3>Personlige indstillinger</h3>

oversigt i "Checket ind"

oversigt ved lærlinge detaljer

<div class="row">
    @if (IsLoading)
    {
        <p>Indlæser data</p>
    }
    else
    {
        <div class="col-md-4">
            <EditForm Model="@Instructor" method="post" OnValidSubmit="OnPostAsync" Id="instructorForm" FormName="Create">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div>
                    <input type="hidden" asp-for="Instructor.Id" />
                    <input type="hidden" asp-for="Instructor.UserName" />
                    <input type="hidden" asp-for="Instructor.FirstName" />
                    <input type="hidden" asp-for="Instructor.LastName" />

                </div>
                <div class="col-md-4">

                    <div class="form-group">
                        <label asp-for="Instructor.Email" class="control-label">Email</label>
                        <InputText @bind-value="Instructor.Email" class="form-control" />
                        <span asp-validation-for="Instructor.Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Instructor.Phonenumber" class="control-label">Telefonnummer</label>
                        <InputNumber @bind-value="Instructor.Phonenumber" class="form-control" />
                        <span asp-validation-for="Instructor.Phonenumber" class="text-danger"></span>
                    </div>
                </div>
                <div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label">Password</label>
                        <InputText @bind-value="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label">Gentag password</label>
                        <InputText @bind-value="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <InputRadioGroup @bind-Value="seeCheckedIn" class="form-check-input">
                    <h2>
                        Oversigt i "Checket ind"
                    </h2>
                    <div class="form-check">
                        <InputRadio Value="true" />
                        <label>Se alle lærlinge.</label>
                        <br />
                        <InputRadio Value="false" />
                        <label>Se kun lærlinge der er mødt.</label>
                    </div>
                </InputRadioGroup>
                <InputRadioGroup @bind-Value="seeStudentDetails" class="form-check-input">
                    <h2>
                        Oversigt i "Lærlinge detaljer"
                    </h2>
                    <div class="form-check">
                        <InputRadio Value="true" />
                        <label>Se alle dage.</label>
                        <br />
                        <InputRadio Value="false" />
                        <label>Se kun dage hvor der er checket ind.</label>
                    </div>
                </InputRadioGroup>
                <p></p>
                <input type="submit" value="Opdater" class="btn btn-primary" />
                <button class="btn btn-secondary" @onclick="GoToIndex">Annuler</button>
            </EditForm>
        </div>
    }

</div>

@code {
    private bool IsLoading = true;

    [Parameter]
    public required string Id { get; set; }

    [SupplyParameterFromForm]
    private InstructorRequest Instructor { get; set; } = new InstructorRequest { FirstName = "", LastName = "", UserName = "" };
    [SupplyParameterFromForm]
    private string Password { get; set; } = "";
    [SupplyParameterFromForm]
    private string ConfirmPassword { get; set; } = "";
    [SupplyParameterFromForm]
    private bool seeCheckedIn { get; set; } = false;
    [SupplyParameterFromForm]
    private bool seeStudentDetails { get; set; } = false;

    private LogInResponse? CurrentUserData { get; set; }
    private bool ShouldRedirectToLogin = false;
    private List<Setting?> Settings { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
            CurrentUserData = httpContext.Session.GetObject<LogInResponse>("CurrentUser");

        if (CurrentUserData == null)
        {
            ShouldRedirectToLogin = true;
            return;
        }
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (ShouldRedirectToLogin)
        {
            ShouldRedirectToLogin = false;
            NavigationManager.NavigateTo("/login", true);
        }
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            var instructor = await _instructorService.GetInstructorById(CurrentUserData!.Id);

            if (instructor != null)
                Instructor = new InstructorRequest
                {
                    FirstName = instructor.FirstName,
                    LastName = instructor.LastName,
                    UserName = instructor.UserName,
                    Email = instructor.Email,
                    Phonenumber = instructor.Phonenumber,
                    Password = ""
                };
            else
                NavigationManager.NavigateTo("/login", true);

            Settings = await _settingService.GetAllSettings();

        }
        catch (Exception)
        {
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }
    public async Task<IActionResult?> OnPostAsync()
    {
        if (Password == ConfirmPassword && Password != null && Password != "")
            Instructor.Password = Password;

        Instructor.IsStudent = false;
        Instructor.Deactivated = false;

        if (seeCheckedIn)
        {
            Setting? item = Settings.FirstOrDefault(s => s!.Name == "SeeAllInCheckIn");
            Instructor.Settings!.Add(item!);
        }

        if (seeStudentDetails)
        {
            Setting? item = Settings.FirstOrDefault(s => s!.Name == "SeeAllInStudentDeails");
            Instructor.Settings!.Add(item!);
        }

        var result = await _instructorService.UpdateInstructor(Instructor, Id);
        if (result != null)
        {
            NavigationManager.NavigateTo("/instructors/index", true);
            return null;
        }
        return null;

    }

    private void GoToIndex()
    {
        NavigationManager.NavigateTo("/instructors/index", true);
    }
}
